#include "resource.h"

IDI_APP_ICON ICON "app.ico"

LANGUAGE 0x09, 0x01
1 VERSIONINFO
 FILEVERSION 2,0,9,0
 PRODUCTVERSION 2,0,9,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "IEKSIUZE"
            VALUE "FileDescription", "CH570 Wireless UART and Power Monitor"
            VALUE "FileVersion", "2.0.9"
            VALUE "InternalName", "CH570_Monitor"
            VALUE "OriginalFilename", "CH570_Monitor.exe"
            VALUE "ProductName", "CH570"
            VALUE "ProductVersion", "2.0.9"
            VALUE "ProjectRepository", "https://github.com/siuze/ch570_ina226/releases"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
